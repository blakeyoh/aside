<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      The helper owns microphone capture and hosts ctranslate2 plus
      cffi/ctypes-based native dependencies. The unsigned-executable-memory
      exception is required for their executable runtime kernels and libffi
      trampolines under hardened runtime. Keep both grants scoped to the helper.
    -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
